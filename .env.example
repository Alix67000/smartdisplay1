# Paramètres Outlook facultatifs
VITE_MICROSOFT_CLIENT_ID=
VITE_MICROSOFT_TENANT_ID=organizations
# Variables côté serveur uniquement : ne jamais les préfixer par VITE_
GOOGLE_OAUTH_CLIENT_SECRET=
# Variante déployée automatiquement : secret chiffré et clé de protection, tous deux sensibles
GOOGLE_OAUTH_CLIENT_SECRET_ENCRYPTED=
GOOGLE_OAUTH_WRAP_KEY=
APP_SESSION_SECRET=
NAVASAN_API_KEY=
GEMINI_API_KEY=
ALLOWED_GOOGLE_EMAIL=
GEMINI_MODEL=gemini-3.1-flash-lite
